    "@groundwork/guards": "workspace:*",
    "@groundwork/providers": "workspace:*",
    "fast-xml-parser": "^4.5.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "tsx": "^4.19.1"
  }
}
