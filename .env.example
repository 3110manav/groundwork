# ---- infrastructure ----
DATABASE_URL=postgres://chatsdk:chatsdk@localhost:5432/chatsdk
REDIS_URL=redis://localhost:6379

# ---- platform keys (OURS, not the customer's) ----
# OpenRouter: one key covers both chat (free models) and embeddings.
# Free chat models are genuinely $0 but heavily rate-limited and slow — fine
# for development, not for production traffic. Embeddings are NOT free, but
# run ~$0.02/MTok (cents per site).
OPENROUTER_API_KEY=

# Google Gemini. No daily free cap in the way OpenRouter's free tier has one.
# Verify the adapter against it with:  pnpm --filter @groundwork/providers verify gemini
GEMINI_API_KEY=
# Comma-separated works everywhere a key is read. OpenRouter's free quota
# ("free-models-per-day") is per ACCOUNT and exhausts every free model on that
# key at once, so a second key is the only thing that helps — walking the model
# chain does not. $10 of credits raises one key to 1000 req/day.
# INGEST_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb
# PLATFORM_OPENROUTER_KEYS=sk-or-v1-aaa,sk-or-v1-bbb
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
INGEST_PROVIDER=openrouter
INGEST_CORE_PACK_MODEL=openrouter/free

# Embeddings run on our key on both the ingest and the chat path, because the
# query vector and the index vectors must come from the same model.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Ingestion runs on our models. Core-pack synthesis uses the good one;
# per-page summarisation uses the cheap one.
ANTHROPIC_API_KEY=
INGEST_CORE_PACK_MODEL=claude-opus-5
INGEST_PAGE_MODEL=claude-haiku-4-5

# Metered mode draws from this pool. Leave empty to run BYO-key only.
PLATFORM_ANTHROPIC_KEYS=
PLATFORM_GEMINI_KEYS=

# ---- crypto ----
# 32-byte base64 key wrapping the per-tenant data keys.
# In production this is a KMS key id, not a local secret.
MASTER_KEY_B64=

# ---- runtime ----
PORT=8787
PUBLIC_API_URL=http://localhost:8787
WIDGET_CDN_URL=http://localhost:8788

# ---- retrieval tuning ----
# Cosine-similarity floor for the confidence gate. Measured against
# text-embedding-3-small: clear hits land 0.38-0.53, paraphrases ~0.22,
# off-topic 0.03-0.13. Default 0.18. Raise to reduce hallucination risk at the
# cost of more "I don't know"; lower for the reverse. A reranker replaces this.
RETRIEVAL_MIN_SIMILARITY=0.18
