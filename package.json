{
  "name": "groundwork",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@groundwork/api --filter=@groundwork/worker --filter=@groundwork/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @groundwork/db migrate",
    "setup": "pnpm install && pnpm --filter @groundwork/widget build && pnpm db:migrate",
    "stop": "pkill -f 'tsx.*--env-file' || true",
    "start": "pnpm --filter @groundwork/api start"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}